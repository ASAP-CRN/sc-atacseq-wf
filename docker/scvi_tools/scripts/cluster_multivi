#!/usr/bin/env python3

import argparse
import scanpy as sc
import mudata as md
import hdf5plugin


def cluster(
    mdata: md.MuData, latent_key: str, leiden_resolutions, n_neighbors: int
):
    print(f"Building neighbors graph on {latent_key} (n_neighbors={n_neighbors})")
    sc.pp.neighbors(mdata, use_rep=latent_key, n_neighbors=n_neighbors)

    for res in leiden_resolutions:
        key = f"leiden_multivi_{res:4.2f}"
        print(f"Leiden clustering at resolution {res} -> {key}")
        sc.tl.leiden(
            mdata,
            resolution=res,
            key_added=key,
            flavor="igraph",
            n_iterations=2,
            directed=False
        )
        n_clusters = mdata.obs[key].nunique()
        print(f"  {key}: {n_clusters} clusters")

    sc.tl.umap(mdata)

    sc.pl.umap(
        mdata,
        save=".png"
    )
    print(f"Wrote umap.png; will rename")

    return mdata


def main(args):
    mdata = md.read_h5mu(args.mudata_input)

    if args.latent_key not in mdata.obsm:
        raise ValueError(
            f"Latent '{args.latent_key}' not found in mdata.obsm. Run "
            f"integrate_multivi first. Available: {list(mdata.obsm.keys())}."
        )

    leiden_resolutions = [float(r) for r in args.leiden_res]

    mdata = cluster(
        mdata, args.latent_key, leiden_resolutions, args.n_neighbors
    )

    mdata.write(
        filename=args.mudata_output,
        compression="gzip"
    )
    print(f"Wrote {args.mudata_output}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Cluster paired Multiome cells on the joint MultiVI latent (Leiden + UMAP)"
    )
    parser.add_argument(
        "-a",
        "--mudata-input",
        type=str,
        required=True,
        help="MuData (.h5mu) object for a dataset",
    )
    parser.add_argument(
        "-l",
        "--latent-key",
        type=str,
        required=True,
        help="Latent key to save the MultiVI latent to",
    )
    parser.add_argument(
        "-n",
        "--n-neighbors",
        type=int,
        default=15,
        help="The size of local neighborhood (in terms of number of neighboring data points) used for manifold approximation [15]",
    )
    parser.add_argument(
        "-e",
        "--leiden-res",
        type=str,
        nargs="+",
        required=True,
        help="Leiden resolutions which are the parameter values controlling the coarseness of the clustering [0.2, 0.5, 1.0]",
    )
    parser.add_argument(
        "-o",
        "--mudata-output",
        type=str,
        required=True,
        help="Output file name for saving the MuData object",
    )

    args = parser.parse_args()

    main(args)
