#!/usr/bin/env python3

import os
import argparse
import numpy as np
import pandas as pd
import anndata as ad
import scipy.sparse as sp
import scanpy as sc
import scvi
import mudata as md
import hdf5plugin


def get_counts(adata, counts_layer):
    if counts_layer and counts_layer in adata.layers:
        return adata.layers[counts_layer]
    return adata.X


def build_paired_anndata(mdata: md.MuData, counts_layer: str):
    """
    Flatten a fully-paired Multiome MuData into the single AnnData that
    scvi.model.MULTIVI expects: RNA (gene) features followed by ATAC (peak)
    features over the shared barcodes, with raw counts in a 'counts' layer and a
    'modality' column in .var marking 'Gene Expression' vs 'Peaks'.

    NOTE: this deliberately does NOT use scvi.data.organize_multiome_anndatas,
    which is for UNPAIRED data (it stacks RNA-only + ATAC-only + paired cells and
    zero-pads the missing modality). All of our cells are paired, so we simply
    concatenate the two feature blocks along var.
    """
    print(f"Building paired AnnData from MuData...")

    # Shared barcodes only. joint_qc subsets both modalities to the same index, so
    # this already holds; assert it rather than re-deriving, since intersect_obs is
    # a muon function and mudata (the data structure alone) has no `pp`.
    rna = mdata.mod["rna"]
    atac = mdata.mod["atac"]
    if not rna.obs_names.equals(atac.obs_names):
        raise ValueError(
            f"RNA and ATAC observation axes differ (RNA={rna.n_obs}, ATAC={atac.n_obs}). "
            "MULTIVI requires fully paired cells; rebuild the MuData with joint_qc."
        )

    # Keep only selected features per modality (mirrors integrate_peakvi/integrate_scvi).
    # NB: verify the column name -- RNA `process` may call this 'highly_variable'.
    if "selected" in rna.var:
        rna = rna[:, rna.var["selected"]].copy()
    else:
        rna = rna.copy()
    if "selected" in atac.var:
        atac = atac[:, atac.var["selected"]].copy()
    else:
        atac = atac.copy()

    # Align both modalities to the same barcode order before concatenating var-wise
    barcodes = rna.obs_names
    atac = atac[barcodes].copy()

    rna_counts = sp.csr_matrix(get_counts(rna, counts_layer))
    atac_counts = sp.csr_matrix(get_counts(atac, counts_layer))

    n_genes = rna.n_vars
    n_peaks = atac.n_vars
    print(f"n_genes={n_genes}  n_peaks={n_peaks}  n_cells={rna.n_obs}")

    X = sp.hstack([rna_counts, atac_counts], format="csr")

    rna_var = rna.var.copy()
    rna_var["modality"] = "Gene Expression"
    atac_var = atac.var.copy()
    atac_var["modality"] = "Peaks"
    var = pd.concat([rna_var, atac_var], axis=0)
   
    if not var.index.is_unique:
        var.index = (
            [f"{n}" for n in rna.var_names]
            + [f"{n}" for n in atac.var_names]
        )

    adata_paired = ad.AnnData(X=X, obs=rna.obs.copy(), var=var)
    adata_paired.layers["counts"] = X.copy()
    return adata_paired, n_genes, n_peaks


def train_model(
    adata: sc.AnnData, batch_key: str, latent_key: str, max_epochs: int, n_hidden: int, batch_size: int
):
    print(f"Training data with MultiVI...")
    scvi.model.MULTIVI.setup_anndata(
        adata,
        batch_key=batch_key,
        layer="counts"
    )

    # n_genes / n_regions inferred from the 'modality' column in .var
    n_genes = int((adata.var["modality"] == "Gene Expression").sum())
    n_regions = int((adata.var["modality"] == "Peaks").sum())

    model = scvi.model.MULTIVI(
        adata,
        n_genes=n_genes,
        n_regions=n_regions,
        n_hidden=n_hidden
    )
    print(f"params={sum(p.numel() for p in model.module.parameters())/1e6:.1f}M")
    model.train(max_epochs=max_epochs, batch_size=batch_size)

    latent = model.get_latent_representation()
    adata.obsm[latent_key] = latent
    print(f"Latent space dim: {latent.shape}")

    return adata, model


def main(args):
    # Set the number of data loader workers
    scvi.settings.dl_num_workers = max(1, os.cpu_count() - 1)
    print(f"Using {scvi.settings.dl_num_workers} workers")

    mdata = md.read_h5mu(args.mudata_input)

    adata_paired, n_genes, n_peaks = build_paired_anndata(mdata, args.counts_layer)

    adata_multivi, multivi_model = train_model(
        adata_paired, args.batch_key, args.latent_key, args.max_epochs, args.n_hidden, args.batch_size
    )

    multivi_model.save(args.output_multivi_dir, overwrite=True)
    print(f"Wrote MultiVI model to {args.output_multivi_dir}")

    # Write the joint latent back to the shared obsm of the MuData source of truth,
    # aligned to the MuData barcode order (obsm is a plain array, so reindex explicitly)
    latent_df = pd.DataFrame(
        adata_multivi.obsm[args.latent_key], index=adata_multivi.obs_names
    )
    mdata.obsm[args.latent_key] = latent_df.reindex(mdata.obs_names).to_numpy()
    mdata.write(
        filename=args.mudata_output,
        compression="gzip"
    )
    print(f"Wrote {args.mudata_output}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Run MultiVI integration on paired Multiome data"
    )
    parser.add_argument(
        "-a",
        "--mudata-input",
        type=str,
        required=True,
        help="MuData (.h5mu) object with paired 'rna' and 'atac' modalities",
    )
    parser.add_argument(
        "-b",
        "--batch-key",
        type=str,
        required=True,
        help="Key in MuData object for batch information"
    )
    parser.add_argument(
        "-c",
        "--counts-layer",
        type=str,
        default="counts",
        help="Layer holding raw counts in each modality; falls back to .X if absent [counts]",
    )
    parser.add_argument(
        "-l",
        "--latent-key",
        type=str,
        required=True,
        help="Latent key to save the MultiVI latent to",
    )
    parser.add_argument(
        "-m",
        "--max-epochs",
        type=int,
        required=True,
        help="The maximum number of full passes through the training data during MultiVI model training [300]",
    )
    parser.add_argument(
        "-n",
        "--n-hidden",
        type=int,
        required=True,
        help="Number of nodes per hidden layer (i.e., the number of neurons per fully-connected layer between the input features and the latent space) [128]",
    )
    parser.add_argument(
        "-z",
        "--batch-size",
        type=int,
        required=True,
        help="Training batch size for MultiVI. Controls how many cells are processed per training step [128]",
    )
    parser.add_argument(
        "-o",
        "--mudata-output",
        type=str,
        required=True,
        help="Output file name for saving the MuData object"
    )
    parser.add_argument(
        "-s",
        "--output-multivi-dir",
        type=str,
        required=True,
        help="Output folder to save MultiVI model",
    )

    args = parser.parse_args()

    main(args)
