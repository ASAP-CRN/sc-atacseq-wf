#!/usr/bin/env python3

import os
import argparse
import pandas as pd
import scvi
import mudata as md
import hdf5plugin


def counts_layer_for(adata, counts_layer):
    """The layer name to hand scvi for this modality, or None to fall back to .X."""
    if counts_layer and counts_layer in adata.layers:
        return counts_layer
    return None


def select_features(adata, name: str):
    """Subset to var['selected'] when present, reporting either way."""
    if "selected" in adata.var:
        n = int(adata.var["selected"].sum())
        print(f"  {name}: {n} of {adata.n_vars} features selected")
        return adata[:, adata.var["selected"]].copy()
    print(f"  {name}: no var['selected']; using all {adata.n_vars} features")
    return adata.copy()


def prepare_paired_mudata(mdata: md.MuData):
    """
    Subset each modality to its selected features and return a MuData that
    MULTIVI.setup_mudata can register.
    """
    print("Preparing paired MuData for MultiVI...")

    rna = mdata.mod["rna"]
    atac = mdata.mod["atac"]
    if not rna.obs_names.equals(atac.obs_names):
        raise ValueError(
            f"RNA and ATAC observation axes differ (RNA={rna.n_obs}, ATAC={atac.n_obs}). "
            "MULTIVI requires fully paired cells; rebuild the MuData with joint_qc."
        )

    # Keep only selected features per modality (mirrors integrate_peakvi/integrate_harmony).
    # ATAC carries var['selected'] from snap.pp.select_features in merge_and_qc, which only
    # marks features -- without subsetting here MULTIVI would get every 500bp tile. RNA
    # reaches us straight from the `filter` task, before `process` computes highly variable
    # genes, so it has no selection column and all genes are used.
    rna = select_features(rna, "rna")
    atac = select_features(atac, "atac")
    print(f"{rna.n_vars} genes, {atac.n_vars} peaks over {rna.n_obs} paired cells")

    paired = md.MuData({"rna": rna, "atac": atac})
    paired.update()
    return paired


def train_model(
    mdata: md.MuData, batch_key: str, counts_layer: str, max_epochs: int,
    n_hidden: int, batch_size: int
):
    print("Training data with MultiVI...")
    scvi.model.MULTIVI.setup_mudata(
        mdata,
        rna_layer=counts_layer_for(mdata.mod["rna"], counts_layer),
        atac_layer=counts_layer_for(mdata.mod["atac"], counts_layer),
        batch_key=batch_key,
        modalities={"rna_layer": "rna", "atac_layer": "atac", "batch_key": "rna"},
    )

    # n_genes / n_regions come from the registered MuData
    model = scvi.model.MULTIVI(mdata, n_hidden=n_hidden)
    print(f"params={sum(p.numel() for p in model.module.parameters())/1e6:.1f}M")
    model.train(max_epochs=max_epochs, batch_size=batch_size)

    latent = model.get_latent_representation()
    print(f"Latent space dim: {latent.shape}")

    return latent, model


def main(args):
    # Set the number of data loader workers
    scvi.settings.dl_num_workers = max(1, os.cpu_count() - 1)
    print(f"Using {scvi.settings.dl_num_workers} workers")

    mdata = md.read_h5mu(args.mudata_input)

    paired = prepare_paired_mudata(mdata)

    latent, multivi_model = train_model(
        paired, args.batch_key, args.counts_layer, args.max_epochs, args.n_hidden, args.batch_size
    )

    multivi_model.save(args.output_multivi_dir, overwrite=True)
    print(f"Wrote MultiVI model to {args.output_multivi_dir}")

    latent_df = pd.DataFrame(latent, index=paired.obs_names)
    mdata.obsm[args.latent_key] = latent_df.reindex(mdata.obs_names).to_numpy()
    mdata.write(
        filename=args.mudata_output,
        compression="gzip"
    )
    print(f"Wrote {args.mudata_output}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Run MultiVI integration on paired Multiome data"
    )
    parser.add_argument(
        "-a",
        "--mudata-input",
        type=str,
        required=True,
        help="MuData (.h5mu) object with paired 'rna' and 'atac' modalities",
    )
    parser.add_argument(
        "-b",
        "--batch-key",
        type=str,
        required=True,
        help="Key in MuData object for batch information"
    )
    parser.add_argument(
        "-c",
        "--counts-layer",
        type=str,
        default="counts",
        help="Layer holding raw counts in each modality; falls back to .X if absent [counts]",
    )
    parser.add_argument(
        "-l",
        "--latent-key",
        type=str,
        required=True,
        help="Latent key to save the MultiVI latent to",
    )
    parser.add_argument(
        "-m",
        "--max-epochs",
        type=int,
        required=True,
        help="The maximum number of full passes through the training data during MultiVI model training [300]",
    )
    parser.add_argument(
        "-n",
        "--n-hidden",
        type=int,
        required=True,
        help="Number of nodes per hidden layer (i.e., the number of neurons per fully-connected layer between the input features and the latent space) [128]",
    )
    parser.add_argument(
        "-z",
        "--batch-size",
        type=int,
        required=True,
        help="Training batch size for MultiVI. Controls how many cells are processed per training step [128]",
    )
    parser.add_argument(
        "-o",
        "--mudata-output",
        type=str,
        required=True,
        help="Output file name for saving the MuData object"
    )
    parser.add_argument(
        "-s",
        "--output-multivi-dir",
        type=str,
        required=True,
        help="Output folder to save MultiVI model",
    )

    args = parser.parse_args()

    main(args)
