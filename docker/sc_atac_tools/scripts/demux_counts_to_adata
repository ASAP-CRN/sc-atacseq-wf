#!/usr/bin/env python3

import argparse
import pandas as pd
import snapatac2 as snap


def get_donor_barcodes(vireo: pd.DataFrame, pool_id: str, subject_id: str) -> list[str]:
    """Extract cell barcodes assigned to a specific donor from the Vireo assignment file.

    Strips the pool suffix from full_barcode (e.g. 'AAACAGCCACCTAAGC-mo002a')
    and replaces it with the Cell Ranger GEM group suffix '-1'
    (e.g. 'AAACAGCCACCTAAGC-1') to match the fragment file barcode format.

    Doublets and unassigned cells are excluded.
    """
    vireo_pool_suffix = pool_id.replace("-ATAC", "").lower()  # MO007b-ATAC -> mo007b

    real_cells = vireo[~vireo["donor_id"].isin(["doublet", "unassigned"])]
    donor_cells = real_cells[
        (real_cells["donor_id"] == subject_id) &
        (real_cells["full_barcode"].str.endswith(f"-{vireo_pool_suffix}"))
    ]

    if donor_cells.empty:
        raise ValueError(
            f"Subject '{subject_id}' not found in Vireo assignment file "
            f"or all cells were doublets/unassigned."
        )

    # Strip pool suffix, keep 16bp barcode sequence + "-1"
    # e.g. "AAACAGCCACCTAAGC-mo002a" -> "AAACAGCCACCTAAGC-1"
    barcodes = (donor_cells["full_barcode"].str.split("-").str[0] + "-1").tolist()
    print(f"Found {len(barcodes)} barcodes for subject '{subject_id}'")

    return barcodes


def add_metadata(
    adata: snap.AnnData,
    team_id: str,
    dataset_id: str,
    subject_id: str,
    sample_id: str,
    pool_id: str,
    batch: str,
):
    """Add ASAP-standard obs metadata to a demultiplexed sample-level AnnData object."""
    print("Adding metadata to demultiplexed sample-level AnnData object")
    adata.obs["subject"] = subject_id
    adata.obs["sample"] = sample_id
    adata.obs["pool"] = pool_id
    adata.obs["batch"] = batch
    adata.obs["team"] = team_id
    adata.obs["dataset"] = dataset_id
    # pool_id is the correct batch unit — cells in the same pool share the same
    # library prep and sequencing run, which is what Harmony/PeakVI corrects for
    adata.obs["batch_id"] = f"{team_id}_{dataset_id}_{pool_id}"

    return adata


def main(args):
    vireo = pd.read_csv(args.vireo_assignment)

    # Get this donor's barcodes from vireo, stripped to match fragment file format
    barcodes = get_donor_barcodes(vireo, args.pool_id, args.subject_id)

    # Import fragments for this donor only, computing QC metrics:
    # n_fragment, frac_dup, frac_mito per cell
    adata = snap.pp.import_fragments(
        fragment_file=args.cellranger_atac_fragments,
        chrom_sizes=snap.genome.hg38,
        whitelist=barcodes,
        sorted_by_barcode=False,
    )
    print(f"{args.sample_id}: {adata.n_obs} cells imported")

    if adata.n_obs == 0:
        raise ValueError(
            f"No cells imported for subject '{args.subject_id}' in pool '{args.pool_id}'. "
            f"Check that the Vireo assignment file contains barcodes for this pool "
            f"(expected suffix: mo{args.pool_id[2:].lower()})."
        )

    adata = add_metadata(
        adata,
        team_id=args.team,
        dataset_id=args.dataset_id,
        subject_id=args.subject_id,
        sample_id=args.sample_id,
        pool_id=args.pool_id,
        batch=args.batch,
    )

    adata.write(
        filename=args.adata_output,
        compression="gzip",
    )
    print(f"Wrote {args.adata_output}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description=(
            "Demultiplex a pool-level Cell Ranger ATAC fragment file by sample "
            "using Vireo assignments, producing one sample-level AnnData object "
            "per sample per pool."
        )
    )
    parser.add_argument(
        "-f",
        "--cellranger-atac-fragments",
        type=str,
        required=True,
        help=(
            "Pool-level Cell Ranger ATAC fragments.tsv.gz. "
            "Only barcodes assigned to --sample-id by Vireo will be loaded."
        )
    )
    parser.add_argument(
        "-a",
        "--vireo-assignment",
        type=str,
        required=True,
        help=(
            "Vireo donor assignment CSV with columns: full_barcode, donor_id. "
            "Covers all donors in the pool."
        )
    )
    parser.add_argument(
        "-t",
        "--team",
        type=str,
        required=True,
        help="ASAP CRN team ID; stored in obs['team']."
    )
    parser.add_argument(
        "-d",
        "--dataset-id",
        type=str,
        required=True,
        help="ASAP dataset ID; stored in obs['dataset']."
    )
    parser.add_argument(
        "-p",
        "--pool-id",
        type=str,
        required=True,
        help=(
            "ASAP pool ID; stored in obs['pool'] and used to construct obs['batch_id']."
        )
    )
    parser.add_argument(
        "-s",
        "--subject-id",
        type=str,
        required=True,
        help=(
            "ASAP subject ID; stored in obs['subject_id']."
        )
    )
    parser.add_argument(
        "-n",
        "--sample-id",
        type=str,
        required=True,
        help=(
            "ASAP sample ID; stored in obs['sample']."
        )
    )
    parser.add_argument(
        "-b",
        "--batch",
        type=str,
        required=True,
        help="Batch number; stored in obs['batch']."
    )
    parser.add_argument(
        "-o",
        "--adata-output",
        type=str,
        required=True,
        help=(
            "Output h5ad file path. "
        )
    )

    args = parser.parse_args()

    main(args)
