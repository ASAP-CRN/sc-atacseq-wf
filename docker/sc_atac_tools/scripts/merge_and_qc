#!/usr/bin/env python3

import argparse
import tempfile
import pandas as pd
import kaleido
import snapatac2 as snap
import hdf5plugin


def process_sample(sample_name: str, file_path: str):
    print(f"Processing sample: {sample_name}")
    adata = snap.read(file_path).to_memory()

    snap.metrics.tsse(adata, snap.genome.hg38)

    snap.pp.filter_cells(adata, min_tsse=5)
    # snap.pp.filter_cells(merged_adata, min_counts=5000, min_tsse=10, max_counts=100000)

    snap.pp.scrublet(adata)
    snap.pp.filter_doublets(adata)

    snap.pp.add_tile_matrix(adata, bin_size=500)

    print(f"  {sample_name}: {adata.n_obs} cells after filtering")
    return adata


def merge_and_select_features(adatas: list, n_features: int = 500000):
    print(f"Merging {len(adatas)} processed samples...")

    # Must output to handle n_vars = 0 / no X matrix
    tmp_file = tempfile.mktemp(suffix=".h5ad")
    merged_adata = snap.concat(
        adatas,
        join="inner",
        file=tmp_file,
    )
    merged_adata.close()

    del adatas

    merged_adata = snap.read(tmp_file).to_memory()

    snap.pp.select_features(merged_adata, n_features=n_features)

    # Subset to selected features
    merged_adata = merged_adata[:, merged_adata.var["selected"]].copy()

    print(f"Merged: {merged_adata.n_obs} cells x {merged_adata.n_vars} features")
    return merged_adata


def plot_qc(merged_adata, plot_prefix: str):
    frag_size_distr_out = f"{plot_prefix}.frag_size_distr.png"
    snap.pl.frag_size_distr(
        merged_adata,
        show=False,
        out_file=frag_size_distr_out
    )
    print(f"Wrote {frag_size_distr_out}")

    tsse_out = f"{plot_prefix}.tsse.png"
    snap.pl.tsse(
        merged_adata,
        show=False,
        out_file=tsse_out
    )
    print(f"Wrote {tsse_out}")


def main(args):
    sample_files = []
    # Note that the sample id should be the official ASAP_samples
    with open(args.adata_objects_fofn, "r") as file:
        for sample in file:
            # Check that sample line is not empty
            if sample.strip():
                columns = sample.strip().split("\t")
                sample_files.append(columns)

    print(f"Processing {len(sample_files)} samples")

    # Per-sample QC
    processed = []
    for sample_name, file_path in sample_files:
        adata = process_sample(sample_name, file_path)
        processed.append(adata)

    # Merge and global feature selection
    merged = merge_and_select_features(processed, n_features=500000)

    # QC plots on merged data
    plot_qc(merged, args.plot_prefix)

    # Save outputs
    merged.write(filename=args.adata_output)
    print(f"Wrote {args.adata_output}")

    merged.obs.to_csv(args.output_metadata, index=True)
    print(f"Wrote {args.output_metadata}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Merge AnnData objects and calculate and plot QC metrics including tile matrices, features, and doublets"
    )
    parser.add_argument(
        "-a",
        "--adata-objects-fofn",
        type=str,
        required=True,
        help="Newline-delimited TSV of sample names and paths to the set of input adata objects (file-of-filenames)"
    )
    parser.add_argument(
        "-p",
        "--plot-prefix",
        type=str,
        required=True,
        help="Prefix used to name plots"
    )
    parser.add_argument(
        "-o",
        "--adata-output",
        type=str,
        required=True,
        help="Output file name for saving the AnnData object"
    )
    parser.add_argument(
        "-m",
        "--output-metadata",
        type=str,
        required=True,
        help="Output file name for saving the AnnData object metadata as csv file"
    )

    args = parser.parse_args()

    main(args)
