#!/usr/bin/env python3

import argparse
import tempfile
import os
import pandas as pd
import kaleido
import snapatac2 as snap
import hdf5plugin


def plot_qc(merged_adata, plot_prefix: str):
    frag_size_distr_out = f"{plot_prefix}.frag_size_distr.png"
    snap.pl.frag_size_distr(
        merged_adata,
        show=False,
        out_file=frag_size_distr_out
    )
    print(f"Wrote {frag_size_distr_out}")

    tsse_out = f"{plot_prefix}.tsse.png"
    snap.pl.tsse(
        merged_adata,
        show=False,
        out_file=tsse_out
    )
    print(f"Wrote {tsse_out}")


def main(args):
    sample_files = []
    # Note that the sample id should be the official ASAP_samples
    with open(args.adata_objects_fofn, "r") as file:
        for sample in file:
            # Check that sample line is not empty
            if sample.strip():
                columns = sample.strip().split("\t")
                sample_files.append(columns)

    print(f"Processing {len(sample_files)} samples")

    # Per-sample QC: process one at a time to limit memory
    tmp_files = []
    for i, (sample_name, file_path) in enumerate(sample_files, 1):
        print(f"Processing sample {i}/{len(sample_files)}: {sample_name}", flush=True)
        adata = snap.read(file_path).to_memory()
        snap.metrics.tsse(adata, snap.genome.hg38)
        snap.pp.filter_cells(adata, min_tsse=5)
        # snap.pp.filter_cells(adatas, min_counts=5000, min_tsse=10, max_counts=100000)
        if adata.n_obs == 0:
            print(f"  {sample_name}: no cells remaining after filtering cells, skipping", flush=True)
            continue
        snap.pp.add_tile_matrix(adata, bin_size=500)
        snap.pp.select_features(adata, n_features=500000)
        snap.pp.scrublet(adata)
        snap.pp.filter_doublets(adata)
        if adata.n_obs == 0:
            print(f"  {sample_name}: no cells remaining after doublet removal, skipping", flush=True)
            continue
        print(f"  {sample_name}: {adata.n_obs} cells after filtering", flush=True)

        # Write to local temp file and free memory
        tmp = tempfile.mktemp(suffix='.h5ad')
        adata.write(filename=tmp)
        tmp_files.append((sample_name, tmp))
        del adata

    # Create AnnDataSet from local temp files to get global feature selection
    print(f"Selecting features across {len(tmp_files)} samples...", flush=True)
    dataset = snap.AnnDataSet(
        adatas=[(name, snap.read(f)) for name, f in tmp_files],
        filename=tempfile.mktemp(suffix='.h5ads'),
    )
    snap.pp.select_features(dataset, n_features=500000)
    selected_features = [v for v, s in zip(dataset.var_names, dataset.var["selected"]) if s]
    dataset.close()

    # Load each sample, subset to selected features, concat
    print(f"Merging with {len(selected_features)} selected features...", flush=True)
    adatas = []
    for name, f in tmp_files:
        adata = snap.read(f).to_memory()
        adata = adata[:, selected_features].copy()
        adatas.append(adata)
        os.remove(f)

    merged = snap.concat(adatas, join='inner')

    # QC plots on merged data
    plot_qc(merged, args.plot_prefix)

    # Save outputs
    merged.write(filename=args.adata_output)
    print(f"Wrote {args.adata_output}")

    merged.obs.to_csv(args.output_metadata, index=True)
    print(f"Wrote {args.output_metadata}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Merge AnnData objects and calculate and plot QC metrics including tile matrices, features, and doublets"
    )
    parser.add_argument(
        "-a",
        "--adata-objects-fofn",
        type=str,
        required=True,
        help="Newline-delimited TSV of sample names and paths to the set of input adata objects (file-of-filenames)"
    )
    parser.add_argument(
        "-p",
        "--plot-prefix",
        type=str,
        required=True,
        help="Prefix used to name plots"
    )
    parser.add_argument(
        "-o",
        "--adata-output",
        type=str,
        required=True,
        help="Output file name for saving the AnnData object"
    )
    parser.add_argument(
        "-m",
        "--output-metadata",
        type=str,
        required=True,
        help="Output file name for saving the AnnData object metadata as csv file"
    )

    args = parser.parse_args()

    main(args)
